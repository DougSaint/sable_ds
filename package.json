{
  "name": "sable",
  "private": true,
  "version": "0.0.0",
  "description": "Sable — design system for operational products",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:docs": "pnpm --filter @sable/docs dev",
    "dev:storybook": "pnpm --filter @sable/storybook dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
